{
  "name": "smart-tech-writter",
  "productName": "smart-tech-writter",
  "version": "0.1.0",
  "description": "AI-powered desktop application for technical writing, built with Electron, React, and LangGraph.",
  "main": ".vite/build/index.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dist:portable": "electron-builder --win portable",
    "version:bump": "node scripts/bump-version.mjs",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "build": {
    "appId": "com.smarttechwriter.app",
    "productName": "Smart Tech Writer",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".vite/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "keywords": [],
  "author": {
    "name": "Tim Wang",
    "email": "lazyloadbox@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/mailparser": "^3.4.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "mailparser": "^3.9.11",
    "mammoth": "^1.12.0",
    "openai": "^6.44.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  }
}
