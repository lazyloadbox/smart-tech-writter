{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main (Forge)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": {
        "ELECTRON_REMOTE_DEBUG_PORT": "9222"
      },
      "console": "integratedTerminal",
      "outputCapture": "std",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Electron: Renderer (Attach 9222)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Electron: Main + Renderer",
      "configurations": [
        "Electron: Main (Forge)",
        "Electron: Renderer (Attach 9222)"
      ]
    }
  ]
}
